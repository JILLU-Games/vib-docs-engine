---
import { existsSync } from "node:fs";
import { relative, resolve } from "node:path";
import { BookOpen, Search } from "lucide-astro";
import siteConfig from "../../config/site.config.json";
import BaseLayout from "./BaseLayout.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";

interface Props {
  site?: typeof siteConfig;
}

const { site = siteConfig } = Astro.props;
const publicRoot = resolve(process.cwd(), "public");
const logoPath = resolve(publicRoot, site.brandLogo.replace(/^\/+/, ""));
const logoRelativePath = relative(publicRoot, logoPath);
const brandLogoExists =
  site.brandLogo.startsWith("/") &&
  logoRelativePath !== ".." &&
  !logoRelativePath.startsWith(`..${process.platform === "win32" ? "\\" : "/"}`) &&
  existsSync(logoPath);
const externalLinks = site.navLinks.map((link) => ({
  ...link,
  external: /^https?:\/\//i.test(link.href),
}));
---

<BaseLayout title={site.portalTitle} description={site.portalSubtitle} accentColor={site.defaultAccent}>
  <div class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-30 h-[52px] border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)]/95 backdrop-blur">
      <div class="mx-auto flex h-full max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
        <a class="flex min-w-0 items-center gap-2 text-sm font-semibold text-[var(--text-primary)] no-underline" href="/" aria-label={`${site.brandName} docs home`}>
          {brandLogoExists ? (
            <img class="size-6 shrink-0 object-contain" src={site.brandLogo} alt="" width="24" height="24" />
          ) : (
            <span class="grid size-6 shrink-0 place-items-center rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--accent-color)]" aria-hidden="true">
              <BookOpen class="size-3.5" />
            </span>
          )}
          <span class="truncate">{site.brandName}</span>
          <span class="hidden rounded border border-[var(--border-hairline)] px-1.5 py-0.5 text-[10px] font-medium text-[var(--text-muted)] sm:inline-flex">Docs</span>
        </a>

        <div class="flex shrink-0 items-center gap-2">
          <button
            class="inline-flex h-[30px] items-center gap-2 rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-2 text-xs text-[var(--text-muted)] transition-colors hover:bg-[var(--bg-hover)] hover:text-[var(--text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-color)]"
            type="button"
            data-search-trigger
            aria-label="Search all documentation"
          >
            <Search class="size-3.5 shrink-0" aria-hidden="true" />
            <span class="hidden sm:inline">Search all docs...</span>
            <kbd class="hidden rounded border border-[var(--border-hairline)] px-1 py-px font-mono text-[10px] leading-4 text-[var(--text-muted)] md:inline-flex">Ctrl K</kbd>
          </button>

          <nav class="hidden items-center gap-3 md:flex" aria-label="External links">
            {externalLinks.map((link) => (
              <a
                class="max-w-28 truncate text-xs text-[var(--text-muted)] no-underline transition-colors hover:text-[var(--text-primary)]"
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))}
          </nav>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <slot />

    <footer class="mt-auto border-t border-[var(--border-hairline)]">
      <div class="mx-auto flex min-h-11 max-w-6xl items-center px-4 text-xs text-[var(--text-muted)] sm:px-6 lg:px-8">
        © {new Date().getFullYear()} {site.brandName}
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-search-trigger]").forEach((button) => {
    button.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("vib:open-search"));
    });
  });
</script>
