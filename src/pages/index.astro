---
import { Search } from "lucide-astro";
import manifest from "../generated/manifest.json";
import CategoryTabs from "../components/hub/CategoryTabs.astro";
import ProjectCard from "../components/hub/ProjectCard.astro";
import HubLayout from "../layouts/HubLayout.astro";
import type { ManifestProject, SiteConfig } from "../utils/manifest";
import { buildBalancedStartLinks } from "../utils/search";
import { buildHubJsonLd } from "../utils/seo";

const projects = manifest.projects as ManifestProject[];
const startLinks = buildBalancedStartLinks(
  projects,
  Math.min(3, Math.max(2, projects.length)),
);
const hubJsonLd = buildHubJsonLd(manifest.site as SiteConfig, projects);
---

<HubLayout
  site={manifest.site}
  projects={projects}
  structuredData={hubJsonLd}
  showHeaderSearch={false}
>
  <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 sm:px-6 lg:px-8">
    <section class="border-b border-[var(--border-hairline)] py-5 sm:py-6" aria-labelledby="portal-title">
      <div class="max-w-3xl">
        <h1 id="portal-title" class="text-xl font-medium leading-tight tracking-tight text-[var(--text-primary)] sm:text-2xl [text-wrap:balance]">
          {manifest.site.portalTitle}
        </h1>
        <p class="mt-1.5 text-sm leading-5 text-[var(--text-muted)]">
          {manifest.site.portalSubtitle}
        </p>

        <div class="mt-4 max-w-lg">
          <button
            type="button"
            data-search-trigger
            class="flex h-9 w-full cursor-pointer items-center justify-between gap-3 rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 text-xs text-[var(--text-muted)] transition-colors hover:border-[var(--text-muted)]/45 hover:bg-[var(--bg-hover)] hover:text-[var(--text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-color)]"
            aria-label="Search documentation"
          >
            <span class="flex min-w-0 items-center gap-2">
              <Search class="size-3.5 shrink-0 text-[var(--text-muted)]" aria-hidden="true" />
              <span class="truncate">Search documentation...</span>
            </span>
            <kbd class="hidden shrink-0 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-1.5 py-px font-mono text-[10px] leading-4 text-[var(--text-muted)] sm:inline-flex">Ctrl K</kbd>
          </button>
        </div>

        {startLinks.length > 0 && (
          <nav class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs sm:gap-x-2" aria-label="Start here">
            <span class="text-[var(--text-muted)]">Start here:</span>
            {startLinks.map((item, index) => (
              <>
                {index > 0 && <span class="hidden text-[var(--border-hairline)] sm:inline" aria-hidden="true">·</span>}
                <a
                  href={item.route}
                  class="inline-flex min-w-0 items-center gap-1 text-[var(--text-primary)] no-underline transition-colors hover:text-[var(--accent-color)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-color)]"
                >
                  <span class="font-medium">{item.productTitle}:</span>
                  <span class="text-[var(--text-muted)]">{item.title}</span>
                </a>
              </>
            ))}
          </nav>
        )}
      </div>
    </section>

    <section class="py-6 sm:py-7" aria-labelledby="projects-heading">
      <div class="mb-3 flex items-baseline justify-between gap-4">
        <h2 id="projects-heading" class="text-sm font-medium text-[var(--text-primary)]">Documentation</h2>
        <span class="text-xs tabular-nums text-[var(--text-muted)]">
          {projects.length} {projects.length === 1 ? "project" : "projects"}
        </span>
      </div>

      <CategoryTabs categories={manifest.categories} />

      {projects.length > 0 ? (
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      ) : (
        <p class="rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-4 py-6 text-sm text-[var(--text-muted)]">
          No documentation projects are available yet.
        </p>
      )}

      <p class="mt-4 text-sm text-[var(--text-muted)]" data-filter-empty hidden role="status" aria-live="polite">
        No projects match this category.
      </p>
    </section>
  </main>
</HubLayout>
